
Group {
    LayoutMode: Middle;
    Anchor: (Width: 1920, Height: 1080);

    Label #Title {
        Style: (FontSize: 36, RenderBold: true, Alignment: Center, TextColor: (#FFFFFF));
        Text: "TEST";
    }

    Label #NumRound {
        Style: (FontSize: 16, RenderBold: false, Alignment: Center, TextColor: (#CCCCCC));
        Text: "Ronda XX";
    }
}