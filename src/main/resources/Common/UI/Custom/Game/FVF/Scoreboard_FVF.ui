
@Background = PatchStyle(TexturePath: "../images/scoreboard-fvf.png");

Group #Scoreboard {
    LayoutMode: Top;
    Anchor: (Width: 850, Height: 655);
    Background: @Background;

    Group #TopSector {
        LayoutMode: Left;
        Anchor: (Width: 850, Left: 24, Right: 24, Top: 24, Bottom: 12);

        Group #TopSectorLeft {
            LayoutMode: Left;
            FlexWeight: 1;

            Group #Icon {
                Anchor: (Width: 24, Height: 24, Right: 16);
                Background: (Color: #ffffff(0.5));
            }

            Label #NameMap {
                Text: "Competitive | MapExample";
                Style: (FontSize: 18, TextColor: #ffffff(0.5));
            }
        }

        Group #TopSectorRight {
            LayoutMode: Right;
            FlexWeight: 1;

            Label #Timer {
                Text: "00:00";
                Style: (FontSize: 18, TextColor: #ffffff(0.5), Alignment: End);
            }
        }
    }

    Group #MiddleSector {
        LayoutMode: Left;
        Anchor: (Width: 850, Left: 24, Right: 24, Top: 13);

        Group #MiddleSectorLeft {
            LayoutMode: Left;
            FlexWeight: 1;

            Label {
                Text: "Players";
                Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true);
            }
        }

        Group #MiddleSectorRight {
            LayoutMode: Right;
            FlexWeight: 1;

            Label {
                Anchor: (Width: 70, Height: 41);
                Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true);
                Text: "K";
            }
            Label {
                Anchor: (Width: 72, Height: 41);
                Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true);
                Text: "D";
            }
            Label {
                Anchor: (Width: 104, Height: 41);
                Style: (FontSize: 24, TextColor: #ffffff, RenderBold: true);
                Text: "Score";
            }
        }
    }

    Group #BottomSector {
        LayoutMode: Top;
        Anchor: (Width: 850, Left: 24, Right: 24);

        // ── Team 1 ────────────────────────────────────────────────────────────

        Group #Team1Header {
            LayoutMode: Left;
            Anchor: (Height: 20, Top: 5, Bottom: 4);

            Label {
                Anchor: (Right: 8);
                Style: (FontSize: 12, TextColor: #4DA6FF, RenderBold: true, VerticalAlignment: Center);
                Text: "Team 1";
            }
            Label #Team1Rounds {
                Style: (FontSize: 12, TextColor: #4DA6FF(0.65), VerticalAlignment: Center);
                Text: "0 rounds";
            }
        }

        Group #T1DataUser01 {
            LayoutMode: Center;
            Anchor: (Height: 40, Left: 1, Right: 2, Bottom: 4);
            Padding: (Left: 15, Right: 14);
            OutlineColor: #E0B448;
            OutlineSize: 0;

            Group {
                LayoutMode: Left;
                FlexWeight: 1;
                Label #T1Name01 {
                    Style: (FontSize: 18, TextColor: #ffffff, VerticalAlignment: Center);
                    Text: "Username";
                }
            }
            Group {
                LayoutMode: Right;
                Anchor: (Right: 8);
                FlexWeight: 1;

                Group {
                    LayoutMode: Center;
                    Anchor: (Width: 64, Height: 40);
                    Label #T1Kill01 {
                        Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
                        Text: "0";
                    }
                }
                Group {
                    LayoutMode: Center;
                    Anchor: (Width: 64, Height: 40, Left: 4);
                    Label #T1Death01 {
                        Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
                        Text: "0";
                    }
                }
                Group {
                    LayoutMode: Center;
                    Anchor: (Width: 90, Height: 40, Left: 23);
                    Label #T1Score01 {
                        Style: (FontSize: 15, TextColor: #ffffff, RenderBold: true, Alignment: Center, VerticalAlignment: Center);
                        Text: "0";
                    }
                }
            }
        }
