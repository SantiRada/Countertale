                OutlineColor: #333333;
                OutlineSize: 1;
                Padding: (Full: 6);

                Group { FlexWeight: 4; LayoutMode: Middle; Group #GridIcon14 { Anchor: (Width: 148, Height: 84); } }
                Group { FlexWeight: 1; LayoutMode: Middle;
                    Label #GridRarity14 { Style: (FontSize: 10, Alignment: Center, TextColor: #888888); Text: ""; }
                }
                Group { FlexWeight: 2; LayoutMode: Middle;
                    Label #GridName14 { Style: (FontSize: 12, RenderBold: true, Alignment: Center, TextColor: #CCCCCC); Text: ""; }
                }
            }

            Group #GridItem15 {
                LayoutMode: Top;
                Anchor: (Width: 256, Height: 155);
                Background: (Color: #111111);
                OutlineColor: #333333;
                OutlineSize: 1;
                Padding: (Full: 6);

                Group { FlexWeight: 4; LayoutMode: Middle; Group #GridIcon15 { Anchor: (Width: 148, Height: 84); } }
                Group { FlexWeight: 1; LayoutMode: Middle;
                    Label #GridRarity15 { Style: (FontSize: 10, Alignment: Center, TextColor: #888888); Text: ""; }
                }
                Group { FlexWeight: 2; LayoutMode: Middle;
                    Label #GridName15 { Style: (FontSize: 12, RenderBold: true, Alignment: Center, TextColor: #CCCCCC); Text: ""; }
                }
            }
        }

        Label #EmptyLabel {
            Anchor: (Bottom: 12);
            Style: (FontSize: 15, TextColor: #666666, Alignment: Center);
            Text: "No items match the current filters.";
        }

        Group { Anchor: (Height: 16); }

        Button #CloseButton {
            LayoutMode: Center;
            Anchor: (Width: 220, Height: 46);
            Background: @BtnDefault;
            Style: (Default: (Background: @BtnDefault), Hovered: (Background: @BtnHover), Pressed: (Background: @BtnPressed));
            Label { Style: (FontSize: 16, RenderBold: true, Alignment: Center, TextColor: #FFFFFF); Text: "Close"; }
        }

        Group { Anchor: (Height: 16); }
        }
    }
}



