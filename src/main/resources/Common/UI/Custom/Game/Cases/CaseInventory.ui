        Group {
            LayoutMode: Left;
            Anchor: (Height: 26, Bottom: 14);

            Group { FlexWeight: 1; }
            Button #ClearFilters {
                Anchor: (Width: 130, Height: 24);
                Background: @BtnDefault;
