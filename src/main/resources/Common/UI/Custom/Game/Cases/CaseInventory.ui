
@BtnDefault = PatchStyle(TexturePath: "../images/mvp/btn-default.png");
@BtnHover   = PatchStyle(TexturePath: "../images/mvp/btn-hover.png");
@BtnPressed = PatchStyle(TexturePath: "../images/mvp/btn-pressed.png");
@Window     = PatchStyle(TexturePath: "../../Common/ContainerFullPatch.png", Border: 20);
@Panel      = PatchStyle(TexturePath: "../../Common/ContainerPatch.png", Border: 23);
@Header     = PatchStyle(TexturePath: "../../Common/ContainerHeaderNoRunes.png", HorizontalBorder: 35, VerticalBorder: 0);
@NamePanel  = PatchStyle(TexturePath: "../../Common/ContainerPanelPatch.png", Border: 4);

@FilterBase = (
    Default: (Background: @BtnDefault),
    Hovered: (Background: @BtnHover),
    Pressed: (Background: @BtnPressed)
);

Group {
    FlexWeight: 1;
    LayoutMode: CenterMiddle;
    Background: (Color: #000000(0.50));

    Group {
        Anchor: (Width: 1100, Height: 622);
        Background: @Window;
        LayoutMode: Top;
        ContentHeight: 1520;
        ScrollbarStyle: (Size: 8);
        Padding: (Full: 14);

        Group {
            LayoutMode: Left;
            Anchor: (Height: 42, Bottom: 10);
            Background: @Header;
            Padding: (Horizontal: 18, Vertical: 10);

            Group {
                LayoutMode: CenterMiddle;
                Anchor: (Width: 180, Height: 30);
                Background: @NamePanel;
                Padding: (Horizontal: 10);
                Label #Username {
                    Style: (FontSize: 14, RenderBold: true, TextColor: #96a9be, VerticalAlignment: Center);
                    Text: "PLAYER";
                }
            }

            Group {
                FlexWeight: 1;
                LayoutMode: CenterMiddle;
                Label {
                    Style: (FontSize: 20, RenderBold: true, TextColor: #b4c8c9, HorizontalAlignment: Center, VerticalAlignment: Center);
                    Text: "INVENTORY";
                }
            }
            Label #InventoryCount {
                Anchor: (Width: 150, Height: 42);
                Style: (FontSize: 12, TextColor: #96a9be, Alignment: End, VerticalAlignment: Center);
                Text: "0 skins - 0 cases";
            }

            Group { Anchor: (Width: 12, Height: 42); }

            Button #HeaderClose {
                Anchor: (Width: 32, Height: 32);
                Style: (
                    Default: (Background: (TexturePath: "../../Common/ContainerCloseButton.png")),
                    Hovered: (Background: (TexturePath: "../../Common/ContainerCloseButtonHovered.png")),
                    Pressed: (Background: (TexturePath: "../../Common/ContainerCloseButtonPressed.png"))
                );
            }
        }

        Group {
            Background: @Panel;
            LayoutMode: Top;
            Padding: (Full: 22);

        Group {
            LayoutMode: Left;
            Anchor: (Height: 28, Bottom: 6);

            Label {
                Anchor: (Width: 60, Height: 28, Right: 8);
                Style: (FontSize: 12, TextColor: #888888, VerticalAlignment: Center);
                Text: "Rarity:";
            }

            Button #FrAll {
                Anchor: (Width: 46, Height: 26, Right: 4);
                Background: @BtnDefault;
                OutlineColor: #FFFFFF;
                OutlineSize: 2;
                Style: @FilterBase;
                Label { Style: (FontSize: 11, RenderBold: true, Alignment: Center, TextColor: #FFFFFF); Text: "All"; }
            }
            Button #FrMilSpec {
                Anchor: (Width: 82, Height: 26, Right: 4);
                Background: @BtnDefault;
                OutlineColor: #2BB0B5;
                OutlineSize: 0;
                Style: @FilterBase;
                Label { Style: (FontSize: 11, RenderBold: true, Alignment: Center, TextColor: #2BB0B5); Text: "Mil-Spec"; }
            }
            Button #FrRestricted {
                Anchor: (Width: 88, Height: 26, Right: 4);
                Background: @BtnDefault;
                OutlineColor: #5D00FF;
                OutlineSize: 0;
                Style: @FilterBase;
                Label { Style: (FontSize: 11, RenderBold: true, Alignment: Center, TextColor: #5D00FF); Text: "Restricted"; }
            }
            Button #FrClassified {
